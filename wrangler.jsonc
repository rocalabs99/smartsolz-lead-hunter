{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartsolz-lead-hunter",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartsolz-leads",
      "database_id": "73d76a53-a78d-4c0c-a465-7de3c802fae0"
    }
  ]
}
